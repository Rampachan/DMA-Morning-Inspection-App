{
  "headers": [
    {
      "source": "/(MICS\\.apk|app-debug\\.apk)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"MICS.apk\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!MICS\\.apk|app-debug\\.apk|assets/).*)",
      "destination": "/index.html"
    }
  ]
}

