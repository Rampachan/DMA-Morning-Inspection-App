# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=mcrs
DB_PASSWORD=CHANGE_ME
DB_NAME=mcrs_db
DATABASE_URL=postgresql://mcrs:CHANGE_ME@localhost:5432/mcrs_db

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING
JWT_EXPIRY=8h

# ── MinIO ──────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=mcrs-photos
MINIO_REPORTS_BUCKET=mcrs-reports
MINIO_SIGNED_URL_EXPIRY_SECONDS=3600

# ── SMS Provider (swap concrete adapter once vendor is confirmed) ───────────────
SMS_PROVIDER=stub
SMS_PROVIDER_API_KEY=CHANGE_ME
SMS_PROVIDER_API_URL=https://api.smsprovider.example.com/send

# ── Firebase Cloud Messaging ───────────────────────────────────────────────────
FCM_SERVER_KEY=CHANGE_ME

# ── App Config ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SUBMISSION_WINDOW_START=05:00
SUBMISSION_WINDOW_END=07:30
GEO_TOLERANCE_METERS=200
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
LOGIN_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=30
BCRYPT_COST_FACTOR=12
